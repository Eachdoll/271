{
  "name": "donghwa-story-quality",
  "version": "0.3.0",
  "private": true,
  "description": "동화공방 — 보급형 모델로도 좋은 줄거리를 만들기 위한 A·B·C층: 조합형 생성·세계 카드 100(+계절·시간 오버레이)·승인 예시 검색·금지 목록·빔 서치·풍부화·아이 시뮬레이터·주간 코치(A·B) + 골드 24편·증류 주제 1,250·증류 생성기·평가 하네스·LoRA 변환기(C)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "distill": "node dist/cli/distill.js",
    "distill:estimate": "node dist/cli/distill.js --estimate",
    "eval": "node dist/cli/eval.js run",
    "eval:compare": "node dist/cli/eval.js compare",
    "eval:calibrate": "node dist/cli/eval.js calibrate",
    "finetune:data": "node dist/cli/finetune.js",
    "topics:gen": "node dist/cli/topics.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  }
}
